{
  "runtime.version": "Lua 5.1",
  "runtime.path": ["?.lua", "client/?.lua", "server/?.lua", "shared/?.lua"],
  "workspace.checkThirdParty": false,
  "workspace.maxPreload": 20000,
  "workspace.library": [
    ".test-runtime/analysis/umbrella/PZ-Umbrella-Umbrella-98f50ae/library",
    "tools/analysis/stubs"
  ],
  "workspace.ignoreDir": [".git", ".test-runtime", "docs", "tools/tests"],
  "diagnostics.libraryFiles": "Disable",
  "diagnostics.neededFileStatus": {
    "redundant-parameter": "Any",
    "unused-local": "Any",
    "unused-function": "Any"
  }
}
